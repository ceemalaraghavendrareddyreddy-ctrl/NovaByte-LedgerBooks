# Local development (MySQL) — used when DATABASE_URL is not set.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=quickbooks_clone

# Production (Render, or any host handing out a Postgres connection string) —
# set this instead of the DB_* vars above and it takes priority. Render sets
# this automatically when you attach the database from render.yaml.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

SECRET_KEY=change-me-to-a-random-string
MRA_API_URL=http://localhost:5059
MRA_API_KEY=
